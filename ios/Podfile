require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

platform :ios, '10.0'

target 'fitnessTracker' do
  config = use_native_modules!

  use_react_native!(:path => config["reactNativePath"])

  pod 'RNCPicker', :path => '../node_modules/@react-native-community/picker'

  pod 'RNTouchThroughView', :path => '../node_modules/react-native-touch-through-view'

  pod 'RCTSystemSetting', :path => '../node_modules/react-native-system-setting'


  pod 'RNExitApp', :path => '../node_modules/react-native-exit-app'

  target 'fitnessTrackerTests' do
    inherit! :complete
    # Pods for testing
  end

  # Enables Flipper.
  #
  # Note that if you have use_frameworks! enabled, Flipper will not work and
  # you should disable these next few lines.
  use_flipper!
  post_install do |installer|
    flipper_post_install(installer)
  end
end

target 'fitnessTracker-tvOS' do
  # Pods for fitnessTracker-tvOS

  target 'fitnessTracker-tvOSTests' do
    inherit! :search_paths
    # Pods for testing
  end
end
